// Ansible managed - do not edit manually
// key=value patterns (origin=,codename=,label=) are only understood by
// Origins-Pattern; Allowed-Origins expects "<origin>:<archive>" and crashes on them.
Unattended-Upgrade::Origins-Pattern {
{% for origin in packages_apt_update_unattended_origins %}
    "{{ origin }}";
{% endfor %}
};

// Packages to not update automatically
Unattended-Upgrade::Package-Blacklist {
{% for pkg in packages_apt_update_unattended_blacklist %}
    "{{ pkg }}";
{% endfor %}
};

Unattended-Upgrade::AutoFixInterruptedDpkg "{{ packages_apt_update_unattended_autofix | ternary('true', 'false') }}";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "{{ packages_apt_update_unattended_remove_unused | ternary('true', 'false') }}";
Unattended-Upgrade::Remove-Unused-Dependencies "{{ packages_apt_update_unattended_remove_unused | ternary('true', 'false') }}";
Unattended-Upgrade::Automatic-Reboot "{{ packages_apt_update_unattended_reboot | ternary('true', 'false') }}";
Unattended-Upgrade::Automatic-Reboot-Time "{{ packages_apt_update_unattended_reboot_time }}";
{% if packages_apt_update_unattended_mail %}
Unattended-Upgrade::Mail "{{ packages_apt_update_unattended_mail }}";
Unattended-Upgrade::MailOnlyOnError "{{ packages_apt_update_unattended_mail_on_error | ternary('true', 'false') }}";
{% endif %}
Unattended-Upgrade::SyslogEnable "true";
Unattended-Upgrade::Verbose "false";
